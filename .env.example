# 仅用于本地开发或 fake-feishu 调试
CODEX_CLI_VERSION=0.153.4
HOST=0.0.0.0
PORT=3000
CODEX_MODE=mock
CODEX_APP_SERVER_COMMAND=codex
CODEX_APP_SERVER_ARGS=app-server
CODEX_APP_SERVER_LISTEN_URL=ws://127.0.0.1:4500
CODEX_APP_SERVER_MANAGED=false
CODEX_APP_SERVER_MODEL=gpt-6-astra
CODEX_APP_SERVER_MODEL_REASONING_EFFORT=high
# yolo 默认值: never + danger-full-access
CODEX_APP_SERVER_APPROVAL_POLICY=never
CODEX_APP_SERVER_SANDBOX=danger-full-access
# 本地开发默认工作目录。群聊只能绑定这个根目录下的子目录
DEFAULT_WORKSPACE=/home/overlogged
# 群聊工作区映射配置文件。未配置的群消息会被拒绝执行
CHAT_WORKSPACE_BINDINGS_FILE=.codex-feishu-bot/chat-workspaces.json
# 默认导出产物目录。给用户的 ppt/pdf/xlsx 等文件优先写到这里
CODEX_ARTIFACTS_DIR=.codex-feishu-bot/artifacts
# 运行态快照文件。用于容器重启后恢复 chat -> thread 映射和最近消息投影
RUNTIME_STATE_FILE=.codex-feishu-bot/runtime-state.json
FEISHU_BRIDGE_SCRIPT=scripts/feishu-bridge.mjs
# Kimi ACP 命令（host 模式的 kimi 会话通过新 kimi-code 的 `kimi acp` 协议接入）
# 注意：必须能在服务进程 PATH 里解析，否则填绝对路径
KIMI_ACP_COMMAND=kimi
# Pi CLI 配置，默认连接 DeepSeek 官方 API 的 DeepSeek V4.1 Flash（deepseek-flash）；V4 Pro 已下线，指定 DS4 Pro / V4 Pro 也会落到 deepseek-flash
PI_CLI_COMMAND=pi
PI_CLI_PROVIDER=deepseek
PI_CLI_MODEL=deepseek-flash
PI_CLI_THINKING=xhigh
LIVE_UPDATE_DEBOUNCE_MS=1200
FEISHU_PROVIDER=sdk
FEISHU_TRANSPORT=websocket
FEISHU_DOMAIN=feishu
# 长连接看门狗。掉线超过 STALE_MS 就重建 WS 客户端，避免 SDK 慢速重连期间静默丢消息
FEISHU_WS_WATCHDOG_ENABLED=true
FEISHU_WS_WATCHDOG_INTERVAL_MS=60000
FEISHU_WS_WATCHDOG_STALE_MS=180000
# 长连接代理（ws 包不读 HTTPS_PROXY，只能通过代理出网时必须填；留空回退 HTTPS_PROXY/HTTP_PROXY）
FEISHU_WS_PROXY_URL=
FEISHU_WS_PROXY_DISABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FAKE_FEISHU_BASE_URL=http://127.0.0.1:3400
FAKE_FEISHU_WS_URL=ws://127.0.0.1:3400/ws

# Only Codex / codex-auth use this outbound proxy; bot and other backends connect directly.
CODEX_PROXY_URL=
