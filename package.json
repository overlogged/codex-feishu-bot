{
  "name": "codex-feishu-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-feishu-agent": "./scripts/agent-manager-cli.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/integrations/**/*.test.ts src/services/*.test.ts src/stores/*.test.ts",
    "start": "node dist/index.js",
    "bootstrap:env": "./scripts/bootstrap-env.sh",
    "build:host": "./scripts/build-host-app.sh",
    "agent:cli": "node scripts/agent-manager-cli.mjs",
    "agent:cli:install": "./scripts/install-global-agent-cli.sh",
    "codex:host": "./scripts/start-host-codex-app-server.sh",
    "chrome:debug": "./scripts/start-debug-chrome.sh",
    "host:smoke": "./scripts/host-smoke.sh",
    "service:install:user": "./scripts/install-user-services.sh",
    "service:up": "./scripts/service-up.sh",
    "service:down": "./scripts/service-down.sh",
    "service:status": "./scripts/service-status.sh",
    "fake-feishu": "node scripts/fake-feishu-server.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
