COMPOSE_PROJECT_NAME=codex-feishu-bot-real
HOST_RUNTIME_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/ubuntu:24.04
BUILD_NODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:22-bookworm-slim
PNPM_VERSION=10.33.0
NODE_VERSION=24.14.0
CODEX_CLI_VERSION=0.133.0

# 对外暴露给宿主机的 app 端口
APP_PORT=3000
# 默认工作目录。群聊只能绑定这个根目录下的子目录
DEFAULT_WORKSPACE=/home/overlogged
# 群聊工作区映射文件
CHAT_WORKSPACE_BINDINGS_FILE=.codex-feishu-bot/chat-workspaces.json
# 用户可见的导出产物目录
CODEX_ARTIFACTS_DIR=.codex-feishu-bot/artifacts
# 运行态快照文件
RUNTIME_STATE_FILE=.codex-feishu-bot/runtime-state.json
# 宿主机 Codex 调用飞书 API / 发文件时使用的桥接脚本
FEISHU_BRIDGE_SCRIPT=scripts/feishu-bridge.mjs
# 飞书消息更新的防抖窗口，调试时可压低
LIVE_UPDATE_DEBOUNCE_MS=1200

# 飞书区域，一般保持 feishu
FEISHU_DOMAIN=feishu
# 由 Codex 通过飞书开放平台自动化配置后写回
FEISHU_APP_ID=
# 由 Codex 通过飞书开放平台自动化配置后写回
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# 运行时 Codex worker 模型，可按需调整
CODEX_APP_SERVER_MODEL=gpt-5.4
# Kimi CLI 命令；quantdev docker 会复用宿主机 uv tool 里的 kimi 和 ~/.kimi 鉴权
KIMI_CLI_COMMAND=kimi
# Pi CLI 命令与模型配置，默认连接 OpenRouter 的 DeepSeek V4 Pro；消息里指定 DS4 Flash / V4 Flash 时会切换到 Flash
PI_CLI_COMMAND=pi
PI_CLI_PROVIDER=openrouter
PI_CLI_MODEL=deepseek-v4-pro
PI_CLI_THINKING=xhigh
# yolo 默认值: never + danger-full-access
CODEX_APP_SERVER_APPROVAL_POLICY=never
CODEX_APP_SERVER_SANDBOX=danger-full-access
CODEX_APP_SERVER_LISTEN_URL=ws://127.0.0.1:4500
# false 表示 bot 不在本进程内托管启动 Codex，需先在宿主机运行 pnpm codex:host
CODEX_APP_SERVER_MANAGED=false

# 群聊切到 docker 模式时使用的受限执行池
DOCKER_EXECUTION_IMAGE=codex-feishu-bot-session:local
DOCKER_EXECUTION_CONTAINER_NAME=codex-feishu-bot-session-pool
DOCKER_EXECUTION_LISTEN_URL=ws://127.0.0.1:4510
DOCKER_EXECUTION_WS_TOKEN_FILE=.codex-feishu-bot/docker-codex-app-server.ws-token
DOCKER_EXECUTION_MEMORY=half
DOCKER_EXECUTION_BUILD_TARGET=runtime
DOCKER_EXECUTION_EXTERNAL=false
# auto 会在 WSL GPU 环境自动挂载 /dev/dxg 和 /usr/lib/wsl；也支持 off / wsl / nvidia
DOCKER_EXECUTION_GPU=auto
# docker 模式会把这个宿主机根目录原样映射进容器
DOCKER_EXECUTION_MOUNT_ROOT=/home
# 如果设置了显式挂载列表，docker 模式不再使用 DOCKER_EXECUTION_MOUNT_ROOT。
# 格式: host_path:container_path[:ro|rw]，多个条目用英文逗号分隔。
DOCKER_EXECUTION_MOUNTS=

# QuantDev docker session 容器。默认全量映射 /home，只把 QuantFS/common_data 和 QuantFS/prod 覆盖为只读。
# 启用时建议把 DOCKER_EXECUTION_IMAGE 改成 codex-feishu-bot-quantdev-session:local，
# DOCKER_EXECUTION_BUILD_TARGET 改成 quantdev-runtime，DOCKER_EXECUTION_EXTERNAL 改成 true。
# 参考:
# DOCKER_EXECUTION_MOUNTS=/home:/home:rw,/home/overlogged/QuantFS/common_data:/home/overlogged/QuantFS/common_data:ro,/home/overlogged/QuantFS/prod:/home/overlogged/QuantFS/prod:ro
SLOCK_SERVER_URL=https://api.slock.ai
SLOCK_API_KEY=

# 认证方式二选一。
# 1. 推荐：宿主机已有 ~/.codex 时直接复用
CODEX_HOME_SOURCE=/home/overlogged/.codex
# 2. 或者填 OPENAI_API_KEY，宿主机首次启动时会自动 codex login
OPENAI_API_KEY=
